# Copy to .env and edit. .env is never committed.
# Secrets do not go here; see docs/secrets.md.

# laptop or mac (see config/models.yaml)
MODEL_PROFILE=laptop

# Your time zone (IANA name), used to interpret "today", "next week", etc.
HOME_AGENT_TIMEZONE=America/New_York

# Your name as it appears on UDisc scorecards (only needed when the export
# has other players on more scorecards than you). See data/udisc/ in README.
# UDISC_PLAYER=Your Name
